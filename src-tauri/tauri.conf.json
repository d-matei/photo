{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumiere",
  "version": "0.1.1",
  "identifier": "com.matei.lumiere",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lumiere",
        "url": "http://127.0.0.1:7878",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon-128.png"
    ]
  }
}
